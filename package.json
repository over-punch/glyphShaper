{
  "name": "@liiift-studio/glyphshaper",
  "version": "1.0.14",
  "description": "Interactive glyph path editor — click any character, reshape its bezier curves, and watch every instance on the page update instantly",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "opentype.js": "^1.3.4",
    "react": ">=17",
    "react-dom": ">=17",
    "wawoff2": "^2.0.1"
  },
  "peerDependenciesMeta": {
    "opentype.js": {
      "optional": true
    },
    "wawoff2": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/opentype.js": "^1.3.9",
    "@types/react": "^19.0.0",
    "@types/wawoff2": "^1.0.2",
    "@vitejs/plugin-react": "^4.0.0",
    "happy-dom": "^20.10.6",
    "next": "16.2.2",
    "opentype.js": "^1.3.4",
    "react": "^19.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0",
    "wawoff2": "^2.0.1"
  },
  "keywords": [
    "typography",
    "web-typography",
    "frontend",
    "liiift-studio",
    "glyph",
    "bezier",
    "font",
    "opentype",
    "opentype-js",
    "path-editing",
    "font-editor",
    "glyph-editor",
    "bezier-editor",
    "runtime-font",
    "font-face",
    "variable-font",
    "woff2",
    "interactive",
    "react",
    "typescript",
    "css"
  ],
  "author": "Quinn Keaveney <quinn@liiift.studio>",
  "license": "MIT",
  "homepage": "https://glyphshaper.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liiift-Studio/glyphShaper.git"
  },
  "bugs": {
    "url": "https://github.com/Liiift-Studio/glyphShaper/issues"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
